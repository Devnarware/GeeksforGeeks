class Solution {
    public int lengthOfLoop(Node head) {
        // code here
        Node slow = head,
             fast = head ;
        boolean isCycle = false ;
             
        while(fast != null && fast.next != null){
            slow = slow.next ;
            fast = fast.next.next ;
            
            if(slow == fast){
                isCycle = true ;
                break ;
            }
        }
        
        if(isCycle){
            slow = head ;
            
            while(slow != fast){
                slow = slow.next ;
                fast = fast.next ;
            }
        }else{
            return 0 ;
        }
        
        
        int len = 1 ;
        fast = fast.next ;
        
        while(fast != slow){
            fast = fast.next ;
            len++ ;
        }
        
        return len ;
    }
}
